## Tiered assessment parameters
assess_share_params 1  # Whether all stocks assessed for an individual species share same parameters (1) or not (0)

Num_Sexes 1         # Number of sexes
HistYrMin 1        # First historical year (relative to start of run)
HistYrMax 7        # Last historical year (relative to start of run) - should this be dynamically set in model?
OverallMaxAge 100    # Max age across all species - set this to the max of MaxAge below or cohorts * ageclasssize (which ever is larger)

# Seeds for the analysis
Iseedz 0           # Seeds for operating model selectivity
Iseedx 0           # Seeds for sigmaR
Iseedy 0           # Seeds for fake tier1

useGenMnomial 0    # How generate length-age data
CPUElim  0.4       # CPUE limit reference point as a proportion of target reference point
num_avg_year 5.0   # Number of years to do the averaging over

## General SS flags
UseSS 0             # Whether to link with Stock-Synthesis (SS) assessment program - 1 = yes, 0 = perfect knowledge style
AssessDelay 2       # Length of delay in the assessment process (years from data collection to RBC setting)
SSForecastType  2   # SS Forecast type - 0=none; 1=F(SPR); 2=F(MSY) 3=F(Btgt); 4=Ave F (uses first-last relF yrs); 5=input annual F scalar
SSFscalar 0.2       # SS F scalar (only used for Do_Forecast==5)
SSControlRule 2     # Control rule method (1=catch=f(SSB) west coast; 2=F=f(SSB) */
SSControlRuleB 0.25 # Control rule Biomass level for constant F (as frac of Bzero, e.g. 0.40); (Must be > the no F level below)
SSControlRuleTargF 1.0 # Control rule target as fraction of Flimit
SSLoop 2            # Number of forecast loops (1=OFL only; 2=ABC; 3=get F from forecast ABC catch with allocations applied)
SSLoopWithRandRec 2 # First forecast loop with stochastic recruitment
SSTol 0.0001        # SS convergence tolerance - final convergence criteria (e.g. 1.0e-04)
SSDepletionBasis 1  # SS Depletion basis:  denom is: 0=skip; 1=rel X*B0; 2=rel X*Bmsy; 3=rel X*B_styr
SSFractX 1.0        # Fraction (X) for Depletion denominator (e.g. 0.4)  -- NB: Neil had 0.41
SS_SPRreport 4      # SS SPR reporting flag - (1-SPR)_reporting:  0=skip; 1=rel(1-SPR); 2=rel(1-SPR_MSY); 3=rel(1-SPR_Btarget); 4=notrel 
SS_Freport 1        # SS F reporting flag - F_std reporting: 0=skip; 1=exploit(Bio); 2=exploit(Num); 3=sum(frates)
SSFreportBasis 0    # SS F reporting basis - F_report_basis: 0=raw; 1=rel Fspr; 2=rel Fmsy ; 3=rel Fbtgt
SSnoBiasAdj 0       # SS last year of no bias adjustment - relative to model start (last_early_yr_nobias_adj_in_MPD)
SSnumGrowthPatterns 1  # SS number of growth patterns - minimum of 1


UseAtlantisPGMSY 0  # Whether to use Atlantis coded version of PGMSY ##JMK
ProjYr 30           # Length of PGMSY projection ##JMK
ThresholdDepletion 0.2  #  Threshold depletion for PGMSY ##JMK
ThresholdBound 0.02  #  Bound for depletion convergence for PGMSY ##JMK
MaxIteration 1000  # Maximum number of PGMSY iterations ##JMK

